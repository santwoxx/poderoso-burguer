rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função para verificar se o usuário é o administrador autenticado via Google
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email != null 
        && (request.auth.token.email.lower() == 'emanoelcarmo00@gmail.com' || request.auth.token.email.lower() == 'brisasofc@gmail.com');
    }

    // Função de validação básica para prevenir spam malicioso no banco de dados
    function isValidOrder() {
      let incoming = request.resource.data;
      return incoming.keys().hasAll(['customerName', 'customerPhone', 'total', 'status', 'items'])
        && incoming.total >= 0
        && incoming.status == 'ANALYSIS'
        && incoming.customerName is string
        && incoming.customerName.size() > 0;
    }

    // 1. Coleção de Pedidos (orders)
    match /orders/{orderId} {
      // Qualquer cliente pode ler um pedido específico (ID UUID inadvinhável)
      allow get: if true;
      // Valida o pedido antes de permitir a criação
      allow create: if isValidOrder() || isAdmin();
      // Apenas o Administrador pode listar todos os pedidos
      allow list: if isAdmin();
      // Apenas Administradores podem atualizar o status ou excluir pedidos
      allow update, delete: if isAdmin();
    }

    // 2. Coleção de Produtos/Cardápio (products)
    match /products/{productId} {
      // Leitura pública do cardápio
      allow read: if true;
      // Apenas o Administrador pode criar, editar ou apagar produtos
      allow write, create, update, delete: if isAdmin();
    }

    // 3. Coleção de Bairros e Taxas de Entrega (neighborhoods)
    match /neighborhoods/{neighborhoodId} {
      // Leitura pública dos bairros e taxas de entrega
      allow read: if true;
      // Apenas o Administrador pode cadastrar, editar ou apagar bairros e taxas
      allow write, create, update, delete: if isAdmin();
    }

    // 4. Coleção de Configurações da Loja (settings)
    match /settings/{settingId} {
      // Leitura pública das configurações (tema, funcionamento, etc.)
      allow read: if true;
      // Apenas o Administrador pode alterar as configurações da loja
      allow write, create, update, delete: if isAdmin();
    }

    // 5. Coleção de Clientes cadastrados via Login Google (customers)
    // O ID do documento é sempre o UID do Firebase Auth do próprio cliente.
    match /customers/{uid} {
      // O cliente só pode ler/criar/editar o próprio cadastro; o Administrador pode ler qualquer um
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // Apenas o Administrador pode listar todos os clientes (aba Clientes do Painel) ou excluir um cadastro
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
